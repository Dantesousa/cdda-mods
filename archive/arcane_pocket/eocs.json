[
  {
    "type": "effect_on_condition",
    "id": "EOC_ARCANE_POCKET_TOGGLE",
    "//": "Toggle between the main world and the arcane pocket dimension.",
    "condition": {
      "compare_string": [ "yes", { "u_val": "in_arcane_pocket" } ]
    },
    "effect": [
      { "u_message": "The arcane energies subside as reality folds back into place around you." },
      { "u_travel_to_dimension": "default", "region_type": "default", "npc_travel_radius": 10, "npc_travel_filter": "all" },
      { "u_teleport": { "u_val": "arcane_origin_location" }, "force_safe": true },
      { "u_add_var": "in_arcane_pocket", "value": "no" }
    ],
    "false_effect": [
      { "u_message": "You speak the words of power, and reality warps around you as the arcane pocket opens." },
      { "u_location_variable": { "u_val": "arcane_origin_location" } },
      {
        "if": { "not": { "compare_string": [ "yes", { "u_val": "arcane_entry_saved" } ] } },
        "then": [
          { "copy_var": { "u_val": "arcane_origin_location" }, "target_var": { "u_val": "arcane_pocket_entry" } },
          { "location_variable_adjust": { "u_val": "arcane_pocket_entry" }, "z_adjust": 0, "z_override": true },
          { "u_add_var": "arcane_entry_saved", "value": "yes" }
        ]
      },
      { "u_teleport": { "u_val": "arcane_pocket_entry" }, "force_safe": true },
      { "u_travel_to_dimension": "dimension_arcane", "region_type": "dimension_arcane", "npc_travel_radius": 10, "npc_travel_filter": "all" },
      { "u_location_variable": { "context_val": "arrival_pos" } },
      { "mapgen_update": "arcane_workshop_update", "target_var": { "context_val": "arrival_pos" } },
      { "u_location_variable": { "context_val": "portal_loc" }, "furniture": "f_arcane_return_portal", "target_max_radius": 48 },
      { "location_variable_adjust": { "context_val": "portal_loc" }, "x_adjust": -2 },
      { "u_teleport": { "context_val": "portal_loc" }, "force_safe": true },
      { "u_add_var": "in_arcane_pocket", "value": "yes" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_RETURN_ARCANE_POCKET",
    "//": "Return from the arcane pocket dimension. Used by f_arcane_return_portal furniture.",
    "effect": [
      { "u_message": "You step through the shimmering portal, and the world reconstitutes around you." },
      { "u_travel_to_dimension": "default", "region_type": "default", "npc_travel_radius": 10, "npc_travel_filter": "all" },
      { "u_teleport": { "u_val": "arcane_origin_location" }, "force_safe": true },
      { "u_add_var": "in_arcane_pocket", "value": "no" }
    ]
  }
]
