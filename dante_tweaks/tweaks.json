[
 {
  "type": "effect_on_condition",
  "id": "EOC_XE_GOT_A_SPELL_LVL",
  "eoc_type": "EVENT",
  "required_event": "player_levels_spell",
  "condition": {
   "math": [
    "time_since('cataclysm') > 2"
   ]
  },
  "effect": [
   {
    "if": {
     "and": [
      {
       "u_has_trait": "EATER"
      },
      {
       "compare_string": [
        "EATER",
        {
         "context_val": "school"
        }
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "xe_eater_leveling++"
      ]
     },
     {
      "u_message": "Got a new level for eater, xe_eater_leveling: <global_val:xe_eater_leveling>",
      "type": "debug"
     }
    ]
   },
   {
    "if": {
     "and": [
      {
       "u_has_trait": "DREAMER"
      },
      {
       "compare_string": [
        "DREAMER",
        {
         "context_val": "school"
        }
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "xe_dreamer_leveling++"
      ]
     },
     {
      "u_message": "Got a new level for dreamer, xe_dreamer_leveling: <global_val:xe_dreamer_leveling>",
      "type": "debug"
     }
    ]
   }
  ]
 },
